{
  "realm": "quickroute",
  "enabled": true,
  "displayName": "QuickRoute",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "roles": { "realm": [{ "name": "CUSTOMER" }, { "name": "RESTAURANT_OWNER" }, { "name": "DRIVER" }, { "name": "ADMIN" }] },
  "clients": [{
    "clientId": "quickroute-frontend",
    "name": "QuickRoute web",
    "enabled": true,
    "protocol": "openid-connect",
    "publicClient": true,
    "standardFlowEnabled": true,
    "directAccessGrantsEnabled": false,
    "implicitFlowEnabled": false,
    "redirectUris": ["http://localhost:4200/*", "http://127.0.0.1:4200/*"],
    "webOrigins": ["http://localhost:4200", "http://127.0.0.1:4200"],
    "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:4200/*##http://127.0.0.1:4200/*" }
  }]
}
